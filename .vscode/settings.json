{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Current File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "showReturnValues": false,
      "env": {
        "PYDEVD_WARN_SLOW_RESOLVE_TIMEOUT": "2",
        "PYDEVD_DISABLE_FILE_VALIDATION": "1"
    }
}
  ]
}